# Pedigree configuration.
# Copy to .env (`cp .env.example .env`) and fill in real values.
# .env is git-ignored. NEVER paste secrets into chat, commits or screenshots.

# --- FalkorDB connection (admin / registry connection) ---------------------
FALKOR_HOST=127.0.0.1
FALKOR_PORT=6379
FALKOR_USERNAME=
FALKOR_PASSWORD=

# --- Pedigree service ------------------------------------------------------
# Admin token for /admin/* and /metrics (generate with: python -c "import secrets;print(secrets.token_urlsafe(32))")
# Non-dev modes (PEDIGREE_ENV != dev/test/local) refuse to start with an empty or known-default token.
PEDIGREE_ADMIN_TOKEN=change-me-admin
# Set PEDIGREE_ENV=production for real deployments (enables the admin-token guard).
# First-run tenant creation without HTTP: `pedigree admin create-tenant --id <tenant>`.
PEDIGREE_ENV=dev
# HMAC key used for content fingerprints (generate like above)
PEDIGREE_SECRET=change-me-hmac
# Per-tenant node cap (Cloud Free deployments use 20000)
PEDIGREE_NODE_CAP=200000
# Store raw prompt/file text? false = hash-only (privacy-preserving default)
PEDIGREE_STORE_TEXT=false
# Session read window K (last K distinct read targets count as influence)
PEDIGREE_READ_WINDOW=50
PEDIGREE_PUBLIC_URL=http://127.0.0.1:8000
PEDIGREE_POLICY_FILE=policy.yaml
# Per-tenant FalkorDB ACL users (defence in depth). Set false where the DB forbids ACL.
PEDIGREE_DB_ACL=true
# Separate deployment secret for deriving tenant DB credentials; generate a strong random value.
PEDIGREE_DB_ACL_SECRET=

# --- Capture adapters (Claude Code hooks / OpenCode plugin) ----------------
PEDIGREE_URL=http://127.0.0.1:8000
# One-time tenant token issued by POST /admin/tenants
PEDIGREE_TOKEN=

# --- Optional: live LLM demo agent. The Pedigree core needs NO LLM. --------
LLM_PROVIDER=
GEMINI_API_KEY=
GROQ_API_KEY=
